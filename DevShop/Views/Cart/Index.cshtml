@model DevShop.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Корзина товаров";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Корзина покупателя</h2>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">Вернуться к покупкам</a>
</div>

@if (Model.Items.Any())
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <span class="fw-bold">Товары в заказе (@Model.TotalCount)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Товар</th>
                                    <th>Цена</th>
                                    <th style="width: 120px;">Количество</th>
                                    <th>Сумма</th>
                                    <th style="width: 100px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@item.ProductName</div>
                                        </td>
                                        <td>@item.ProductPrice.ToString("N0") ₽</td>
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" 
                                                       class="form-control form-control-sm text-center" 
                                                       onchange="this.form.submit()" />
                                            </form>
                                        </td>
                                        <td class="fw-bold">@item.TotalPrice.ToString("N0") ₽</td>
                                        <td class="text-end">
                                            <a asp-action="RemoveFromCart" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                                Удалить
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <span class="fw-bold">Сумма заказа</span>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Всего товаров:</span>
                        <span>@Model.TotalCount шт.</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Доставка:</span>
                        <span class="text-success">Бесплатно</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold">К оплате:</span>
                        <span class="h4 fw-bold text-primary mb-0">@Model.GrandTotal.ToString("N0") ₽</span>
                    </div>
                    <form asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100 py-2">
                            Оформить заказ
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card text-center py-5 shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-2">Ваша корзина пуста</h4>
            <p class="text-muted mb-4">Вы пока не добавили ни одного товара в корзину.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Перейти в каталог</a>
        </div>
    </div>
}
