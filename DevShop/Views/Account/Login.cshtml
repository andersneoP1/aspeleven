@model DevShop.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Вход в систему";
}

<div class="row justify-content-center my-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 text-center">
                <h4 class="h5 fw-bold mb-0">Авторизация</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Login" class="form-label">Логин</label>
                        <input asp-for="Login" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Пароль</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">Запомнить меня</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Войти
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 small">
                <span>Нет учетной записи?</span>
                <a asp-action="Register" class="fw-semibold ms-1">Зарегистрироваться</a>
            </div>
        </div>

        <div class="card mt-3 shadow-sm bg-light">
            <div class="card-body p-3 small text-muted">
                <div class="fw-bold mb-1 text-dark">Тестовые аккаунты:</div>
                <div>Администратор: <code>admin</code> / <code>admin123</code></div>
                <div>Пользователь: <code>developer</code> / <code>dev123</code></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
