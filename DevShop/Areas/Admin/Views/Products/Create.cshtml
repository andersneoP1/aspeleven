@model DevShop.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Добавление товара";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Создание новой карточки товара</h5>
                <a asp-action="Index" class="btn-gh-secondary btn-sm">← Назад к списку</a>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label"></label>
                    <input asp-for="ProductName" class="form-control" placeholder="Например: Механическая клавиатура Keychron Q1 Pro Wireless" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                        <option value="">-- Выберите категорию --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductDescription" class="form-label"></label>
                    <textarea asp-for="ProductDescription" class="form-control" rows="4" placeholder="Подробные технические спецификации, переключатели, интерфейсы подключения, габариты..."></textarea>
                    <span asp-validation-for="ProductDescription" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ProductPrice" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="ProductPrice" class="form-control font-monospace" type="number" step="0.01" />
                            <span class="input-group-text bg-dark border-secondary text-secondary">₽</span>
                        </div>
                        <span asp-validation-for="ProductPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ProductStockQuantity" class="form-label"></label>
                        <input asp-for="ProductStockQuantity" class="form-control font-monospace" type="number" />
                        <span asp-validation-for="ProductStockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductImageUrl" class="form-label">Прямой URL-адрес изображения (опционально)</label>
                    <input asp-for="ProductImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                    <span asp-validation-for="ProductImageUrl" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label">Или загрузить медиафайл с устройства (JPG, PNG, WEBP, до 2 МБ)</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-gh-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">Сохранить товар</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
