@model IEnumerable<DevShop.Models.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Управление товарами";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Каталог товаров</h4>
        <span class="text-muted small">Всего товаров в базе: @Model.Count()</span>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">Добавить товар</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Наименование</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>Остаток</th>
                        <th style="width: 170px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.IdProducts</td>
                            <td>
                                <div class="fw-bold">@item.ProductName</div>
                                <div class="text-muted small text-truncate" style="max-width: 350px;">@item.ProductDescription</div>
                            </td>
                            <td><span class="badge bg-secondary">@item.Category?.CategoryName</span></td>
                            <td>@item.ProductPrice.ToString("N0") ₽</td>
                            <td>
                                @if (item.ProductStockQuantity > 5)
                                {
                                    <span class="badge bg-success">@item.ProductStockQuantity шт.</span>
                                }
                                else if (item.ProductStockQuantity > 0)
                                {
                                    <span class="badge bg-warning text-dark">Мало (@item.ProductStockQuantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Нет</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.IdProducts" class="btn btn-outline-primary btn-sm">
                                        Изменить
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.IdProducts" method="post" class="d-inline" onsubmit="return confirm('Удалить товар?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Удалить
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
