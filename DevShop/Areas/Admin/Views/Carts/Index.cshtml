@model IEnumerable<DevShop.Models.Cart>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Корзины пользователей";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Корзины пользователей</h4>
        <span class="text-muted small">Всего корзин: @Model.Count()</span>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Пользователь</th>
                        <th>Дата создания</th>
                        <th>Товаров</th>
                        <th style="width: 170px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.IdCarts</td>
                            <td>@(item.User?.UserLogin ?? item.UserId.ToString())</td>
                            <td class="text-muted small">@item.CartCreatedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="badge bg-secondary">@item.CartItems.Count шт.</span></td>
                            <td style="text-align: right;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.IdCarts" class="btn btn-outline-info btn-sm">Детали</a>
                                    <form asp-action="Delete" asp-route-id="@item.IdCarts" method="post" class="d-inline" onsubmit="return confirm('Очистить корзину?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
