@model IEnumerable<DevShop.Models.Role>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Управление ролями";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Роли пользователей</h4>
        <span class="text-muted small">Всего ролей: @Model.Count()</span>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">Добавить роль</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Название роли</th>
                        <th>Пользователей</th>
                        <th style="width: 170px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.IdRoles</td>
                            <td class="fw-bold">@item.RoleName</td>
                            <td><span class="badge bg-secondary">@item.Users.Count</span></td>
                            <td style="text-align: right;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.IdRoles" class="btn btn-outline-primary btn-sm">Изменить</a>
                                    @if (item.RoleName != "Admin" && item.RoleName != "User")
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.IdRoles" method="post" class="d-inline" onsubmit="return confirm('Удалить роль?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
