@model IEnumerable<DevShop.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Управление заказами";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Список заказов</h4>
        <span class="text-muted small">Всего заказов: @Model.Count()</span>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">№</th>
                        <th>Пользователь</th>
                        <th>Дата</th>
                        <th>Позиций</th>
                        <th>Сумма</th>
                        <th>Статус</th>
                        <th style="width: 220px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.IdOrders</td>
                            <td>@(item.User?.UserLogin ?? $"ID: {item.UserId}")</td>
                            <td class="text-muted small">@item.OrderDate?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.OrderItems.Count</td>
                            <td class="fw-bold">@item.OrderTotalAmount.ToString("N0") ₽</td>
                            <td>
                                @if (item.OrderStatus == "Completed")
                                {
                                    <span class="badge bg-success">Выполнен</span>
                                }
                                else if (item.OrderStatus == "Processing")
                                {
                                    <span class="badge bg-primary">В обработке</span>
                                }
                                else if (item.OrderStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Ожидает</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.OrderStatus</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.IdOrders" class="btn btn-outline-info btn-sm">Детали</a>
                                    <a asp-action="Edit" asp-route-id="@item.IdOrders" class="btn btn-outline-primary btn-sm">Статус</a>
                                    <form asp-action="Delete" asp-route-id="@item.IdOrders" method="post" class="d-inline" onsubmit="return confirm('Удалить заказ?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
