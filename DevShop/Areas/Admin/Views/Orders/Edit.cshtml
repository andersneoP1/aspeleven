@model DevShop.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Смена статуса заказа #{Model.IdOrders}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Управление статусом заказа #@Model.IdOrders</h5>
                <a asp-action="Index" class="btn-gh-secondary btn-sm">← Назад</a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdOrders" />

                <div class="mb-3">
                    <label class="form-label text-secondary small">Клиент:</label>
                    <div class="fw-semibold text-white">@(Model.User?.UserLogin ?? Model.UserId.ToString())</div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small">Сумма заказа:</label>
                    <div class="fw-bold font-monospace text-white">@Model.OrderTotalAmount.ToString("N0") ₽</div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Статус заказа:</label>
                    <select name="orderStatus" class="form-select">
                        <option value="Pending" selected="@(Model.OrderStatus == "Pending" ? "selected" : null)">Pending (Ожидает обработки)</option>
                        <option value="Processing" selected="@(Model.OrderStatus == "Processing" ? "selected" : null)">Processing (Комплектуется на складе)</option>
                        <option value="Completed" selected="@(Model.OrderStatus == "Completed" ? "selected" : null)">Completed (Успешно доставлен)</option>
                        <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled" ? "selected" : null)">Cancelled (Отменен)</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-gh-secondary">Отмена</a>
                    <button type="submit" class="btn-gh-primary">Обновить статус</button>
                </div>
            </form>
        </div>
    </div>
</div>
