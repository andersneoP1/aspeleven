@model IEnumerable<DevShop.Models.Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Категории товаров";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Категории товаров</h4>
        <span class="text-muted small">Всего категорий: @Model.Count()</span>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">Добавить категорию</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Название</th>
                        <th>Описание</th>
                        <th style="width: 140px;">Товаров</th>
                        <th style="width: 170px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.IdCategories</td>
                            <td class="fw-bold">@item.CategoryName</td>
                            <td class="text-muted small">@item.CategoryDescription</td>
                            <td><span class="badge bg-secondary">@(item.Products?.Count ?? 0) шт.</span></td>
                            <td style="text-align: right;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.IdCategories" class="btn btn-outline-primary btn-sm">
                                        Изменить
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.IdCategories" method="post" class="d-inline" onsubmit="return confirm('Удалить категорию?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Удалить
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
