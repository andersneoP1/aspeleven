@model IEnumerable<DevShop.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Управление пользователями";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Пользователи</h4>
        <span class="text-muted small">Всего пользователей: @Model.Count()</span>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">Добавить пользователя</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Логин</th>
                        <th>Роль</th>
                        <th>Дата регистрации</th>
                        <th style="width: 170px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.IdUsers</td>
                            <td class="fw-bold">@item.UserLogin</td>
                            <td>
                                @if (item.Role?.RoleName == "Admin")
                                {
                                    <span class="badge bg-warning text-dark">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Role?.RoleName</span>
                                }
                            </td>
                            <td class="text-muted small">@item.UserCreatedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td style="text-align: right;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.IdUsers" class="btn btn-outline-primary btn-sm">Изменить</a>
                                    <form asp-action="Delete" asp-route-id="@item.IdUsers" method="post" class="d-inline" onsubmit="return confirm('Удалить пользователя?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
