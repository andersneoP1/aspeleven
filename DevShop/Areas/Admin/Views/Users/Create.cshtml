@model DevShop.Models.User
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Создание пользователя";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Новый пользователь</h5>
                <a asp-action="Index" class="btn-gh-secondary btn-sm">← Назад</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserLogin" class="form-label">Логин</label>
                    <input asp-for="UserLogin" class="form-control" autocomplete="off" />
                    <span asp-validation-for="UserLogin" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Пароль (минимум 6 символов)</label>
                    <input name="password" type="password" class="form-control" required minlength="6" />
                </div>

                <div class="mb-4">
                    <label asp-for="RoleId" class="form-label">Роль в системе</label>
                    <select asp-for="RoleId" class="form-select" asp-items="ViewBag.RoleId"></select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-gh-secondary">Отмена</a>
                    <button type="submit" class="btn-gh-primary">Создать пользователя</button>
                </div>
            </form>
        </div>
    </div>
</div>
