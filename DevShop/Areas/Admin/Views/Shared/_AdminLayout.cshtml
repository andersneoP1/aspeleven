<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Панель администратора - @ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-modern.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="bg-dark text-white p-3">
            <div class="sidebar-heading pb-3 mb-3 border-bottom">
                <h5 class="fw-bold mb-0 text-white">Админ-панель</h5>
                <small class="text-muted">Управление магазином</small>
            </div>

            <div class="nav flex-column">
                <div class="text-uppercase text-muted small fw-bold mb-2">Каталог</div>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Products" asp-action="Index">Товары</a>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Categories" asp-action="Index">Категории</a>

                <div class="text-uppercase text-muted small fw-bold mt-3 mb-2">Продажи</div>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Orders" asp-action="Index">Заказы</a>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderItems" ? "active" : "")" 
                   asp-area="Admin" asp-controller="OrderItems" asp-action="Index">Позиции заказов</a>

                <div class="text-uppercase text-muted small fw-bold mt-3 mb-2">Корзины</div>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Carts" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Carts" asp-action="Index">Корзины клиентов</a>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "CartItems" ? "active" : "")" 
                   asp-area="Admin" asp-controller="CartItems" asp-action="Index">Элементы корзин</a>

                <div class="text-uppercase text-muted small fw-bold mt-3 mb-2">Система</div>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Users" asp-action="Index">Пользователи</a>
                <a class="nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Roles" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Roles" asp-action="Index">Роли</a>

                <div class="mt-4 pt-3 border-top border-secondary">
                    <a class="nav-link-admin text-info" href="/swagger" target="_blank">Swagger API</a>
                    <a class="nav-link-admin text-warning" asp-area="" asp-controller="Products" asp-action="Index">На сайт</a>
                </div>
            </div>
        </nav>

        <!-- Content -->
        <div id="content" class="flex-grow-1 p-4 bg-light">
            <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom bg-white p-3 rounded shadow-sm">
                <div>
                    <h3 class="h4 fw-bold mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary">Администратор: @User.Identity?.Name</span>
                </div>
            </header>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
