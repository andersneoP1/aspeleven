@model DevShop.Models.CartItem
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Редактирование элемента корзины";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Редактирование элемента #@Model.IdCartItems</h5>
                <a asp-action="Index" class="btn-gh-secondary btn-sm">← Назад</a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdCartItems" />

                <div class="mb-3">
                    <label asp-for="CartId" class="form-label">Корзина</label>
                    <select asp-for="CartId" class="form-select" asp-items="ViewBag.CartId"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label">Товар</label>
                    <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId"></select>
                </div>

                <div class="mb-4">
                    <label asp-for="CartItemQuantity" class="form-label">Количество</label>
                    <input asp-for="CartItemQuantity" class="form-control font-monospace" min="1" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-gh-secondary">Отмена</a>
                    <button type="submit" class="btn-gh-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>
