@model IEnumerable<DevShop.Models.CartItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Элементы корзин";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Элементы корзин</h4>
        <span class="text-muted small">Всего записей: @Model.Count()</span>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">Добавить запись</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>№ Корзины</th>
                        <th>Товар</th>
                        <th>Количество</th>
                        <th style="width: 170px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.IdCartItems</td>
                            <td>№@item.CartId</td>
                            <td>@item.Product?.ProductName</td>
                            <td>@item.CartItemQuantity шт.</td>
                            <td style="text-align: right;">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.IdCartItems" class="btn btn-outline-primary btn-sm">Изменить</a>
                                    <form asp-action="Delete" asp-route-id="@item.IdCartItems" method="post" class="d-inline" onsubmit="return confirm('Удалить элемент?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
